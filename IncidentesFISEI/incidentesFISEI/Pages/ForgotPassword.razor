@page "/forgot-password"
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Recuperar Contraseña - IncidentesFISEI</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="login-logo">
                <i class="fas fa-key"></i>
            </div>
            <h2 class="login-title">Recuperar Contraseña</h2>
            <p class="login-subtitle">Ingresa tu correo electrónico para recibir el enlace de recuperación</p>
        </div>

        <EditForm Model="forgotPasswordModel" OnValidSubmit="HandleForgotPassword" class="login-form">
            <DataAnnotationsValidator />
            
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>@errorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle me-2"></i>@successMessage
                </div>
            }

            <div class="form-group">
                <label for="email" class="form-label">
                    <i class="fas fa-envelope me-2"></i>Correo Electrónico
                </label>
                <InputText id="email" @bind-Value="forgotPasswordModel.Email" class="form-control" placeholder="usuario@uta.edu.ec" />
                <ValidationMessage For="@(() => forgotPasswordModel.Email)" class="validation-message" />
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary btn-login" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Enviando...</span>
                    }
                    else
                    {
                        <i class="fas fa-paper-plane me-2"></i>
                        <span>Enviar Enlace de Recuperación</span>
                    }
                </button>
            </div>

            <div class="forgot-password-link">
                <a href="/login" class="text-link">
                    <i class="fas fa-arrow-left me-1"></i>Volver al inicio de sesión
                </a>
            </div>

            <div class="back-to-home-link">
                <a href="/" class="text-link">
                    <i class="fas fa-home me-1"></i>Ir al Inicio
                </a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private ForgotPasswordModel forgotPasswordModel = new();
    private bool isLoading = false;
    private string errorMessage = "";
    private string successMessage = "";

    public class ForgotPasswordModel
    {
        [Required(ErrorMessage = "El email es requerido")]
        [EmailAddress(ErrorMessage = "Ingrese un email válido")]
        public string Email { get; set; } = "";
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public T? Data { get; set; }
        public string Message { get; set; } = "";
        public string[]? Errors { get; set; }
    }

    private async Task HandleForgotPassword()
    {
        try
        {
            isLoading = true;
            errorMessage = "";
            successMessage = "";
            
            var apiBaseUrl = "http://localhost:7001";
            var forgotPasswordUrl = $"{apiBaseUrl}/api/auth/forgot-password";
            
            var request = new { email = forgotPasswordModel.Email };
            var response = await Http.PostAsJsonAsync(forgotPasswordUrl, request);
            var responseContent = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                successMessage = "✅ Se ha enviado un enlace de recuperación a tu correo electrónico. Por favor, revisa tu bandeja de entrada.";
                forgotPasswordModel.Email = "";
                
                // Esperar 3 segundos y redirigir al login
                await Task.Delay(3000);
                Navigation.NavigateTo("/login");
            }
            else
            {
                try
                {
                    var errorResponse = System.Text.Json.JsonSerializer.Deserialize<ApiResponse<object>>(
                        responseContent, 
                        new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                    );
                    errorMessage = errorResponse?.Message ?? "Error al procesar la solicitud";
                }
                catch
                {
                    errorMessage = "El correo electrónico no está registrado en el sistema";
                }
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "No se puede conectar con el servidor. Verifique que la API esté ejecutándose.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
