@page "/configuracion/slas"
@using System.Net.Http.Json
@using System.Text.Json
@using incidentesFISEI.Services
@layout incidentesFISEI.Shared.Components.DashboardLayout
@inject HttpClient Http
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Configuración SLAs - IncidentesFISEI</PageTitle>

<div class="sla-config-container">
    <!-- Título con botón volver alineado -->
    <div class="page-title-section">
        <button class="btn btn-link back-button" @onclick='() => Navigation.NavigateTo("/configuracion")'>
            <i class="fas fa-arrow-left me-2"></i>Volver
        </button>
        <div class="title-content">
            <h1 class="page-main-title">
                <i class="fas fa-clock me-2"></i>Configuración de SLAs
            </h1>
            <p class="page-subtitle">Gestionar tiempos de respuesta y resolución por prioridad</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(messageAlert))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            <i class="fas @(isError ? "fa-exclamation-triangle" : "fa-check-circle") me-2"></i>
            @messageAlert
            <button type="button" class="btn-close" @onclick="() => messageAlert = string.Empty"></button>
        </div>
    }

    <!-- Lista de SLAs -->
    <div class="sla-list-section">
        <div class="section-header">
            <h2>SLAs Configurados</h2>
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="fas fa-plus me-2"></i>Nuevo SLA
            </button>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p class="mt-3">Cargando SLAs...</p>
            </div>
        }
        else if (slaList != null && slaList.Any())
        {
            @foreach (var sla in slaList)
            {
                <div class="sla-card @(sla.IsActive ? "" : "inactive")">
                    <!-- Sección Información -->
                    <div class="sla-card-info">
                        <h3>@sla.Nombre</h3>
                        <p class="sla-description">@(string.IsNullOrEmpty(sla.Descripcion) ? "Sin descripción" : sla.Descripcion)</p>
                        <span class="badge @(sla.IsActive ? "bg-success" : "bg-secondary")">
                            @(sla.IsActive ? "Activo" : "Inactivo")
                        </span>
                    </div>

                    <!-- Sección Respuesta -->
                    <div class="sla-times-respuesta">
                        <h4><i class="fas fa-reply me-2"></i>RESPUESTA</h4>
                        <div class="time-row">
                            <div class="time-item critica">
                                <span class="priority-label">Crítica</span>
                                <span class="time-value">@sla.TiempoRespuestaCritica min</span>
                            </div>
                            <div class="time-item alta">
                                <span class="priority-label">Alta</span>
                                <span class="time-value">@sla.TiempoRespuestaAlta min</span>
                            </div>
                            <div class="time-item media">
                                <span class="priority-label">Media</span>
                                <span class="time-value">@sla.TiempoRespuestaMedia min</span>
                            </div>
                            <div class="time-item baja">
                                <span class="priority-label">Baja</span>
                                <span class="time-value">@sla.TiempoRespuestaBaja min</span>
                            </div>
                        </div>
                    </div>

                    <!-- Sección Resolución -->
                    <div class="sla-times-resolucion">
                        <h4><i class="fas fa-check-circle me-2"></i>RESOLUCIÓN</h4>
                        <div class="time-row">
                            <div class="time-item critica">
                                <span class="priority-label">Crítica</span>
                                <span class="time-value">@FormatMinutes(sla.TiempoResolucionCritica)</span>
                            </div>
                            <div class="time-item alta">
                                <span class="priority-label">Alta</span>
                                <span class="time-value">@FormatMinutes(sla.TiempoResolucionAlta)</span>
                            </div>
                            <div class="time-item media">
                                <span class="priority-label">Media</span>
                                <span class="time-value">@FormatMinutes(sla.TiempoResolucionMedia)</span>
                            </div>
                            <div class="time-item baja">
                                <span class="priority-label">Baja</span>
                                <span class="time-value">@FormatMinutes(sla.TiempoResolucionBaja)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Sección Escalación -->
                    <div class="sla-escalation-compact">
                        <h4><i class="fas fa-level-up-alt me-2"></i>ESCALACIÓN</h4>
                        <div class="escalation-content">
                            <div class="escalation-item">
                                <i class="fas @(sla.PermitirEscalacion ? "fa-check-circle text-success" : "fa-times-circle text-danger")"></i>
                                <span>@(sla.PermitirEscalacion ? "SÍ" : "NO")</span>
                            </div>
                            @if (sla.PermitirEscalacion)
                            {
                                <div class="escalation-item small">
                                    <i class="fas fa-clock text-warning"></i>
                                    <span>@sla.MinutosAntesDeLlegar min</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Footer con fecha y botones -->
                    <div class="sla-card-footer">
                        <small><i class="fas fa-calendar me-1"></i>@sla.CreatedAt.ToString("dd/MM/yyyy")</small>
                        <div class="action-buttons">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditSla(sla)" title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSla(sla.Id)" title="Eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Modal Crear/Editar SLA -->
    @if (showModal)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fas @(isEditMode ? "fa-edit" : "fa-plus") me-2"></i>
                            @(isEditMode ? "Editar SLA" : "Crear Nuevo SLA")
                        </h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="slaForm" OnValidSubmit="SaveSla">
                            <DataAnnotationsValidator />
                            
                            <div class="mb-3">
                                <label class="form-label">Nombre del SLA <span class="text-danger">*</span></label>
                                <InputText @bind-Value="slaForm.Nombre" class="form-control" placeholder="Ej: SLA Predeterminado" />
                                <ValidationMessage For="@(() => slaForm.Nombre)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Descripción</label>
                                <InputTextArea @bind-Value="slaForm.Descripcion" class="form-control" rows="2" placeholder="Descripción del acuerdo de nivel de servicio" />
                            </div>

                            <hr />

                            <h6 class="mb-3"><i class="fas fa-reply me-2"></i>Tiempos de Respuesta (minutos)</h6>
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label class="form-label">Prioridad Crítica</label>
                                    <InputNumber @bind-Value="slaForm.TiempoRespuestaCritica" class="form-control" min="5" max="1440" />
                                    <ValidationMessage For="@(() => slaForm.TiempoRespuestaCritica)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Prioridad Alta</label>
                                    <InputNumber @bind-Value="slaForm.TiempoRespuestaAlta" class="form-control" min="5" max="1440" />
                                    <ValidationMessage For="@(() => slaForm.TiempoRespuestaAlta)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Prioridad Media</label>
                                    <InputNumber @bind-Value="slaForm.TiempoRespuestaMedia" class="form-control" min="5" max="1440" />
                                    <ValidationMessage For="@(() => slaForm.TiempoRespuestaMedia)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Prioridad Baja</label>
                                    <InputNumber @bind-Value="slaForm.TiempoRespuestaBaja" class="form-control" min="5" max="1440" />
                                    <ValidationMessage For="@(() => slaForm.TiempoRespuestaBaja)" />
                                </div>
                            </div>

                            <h6 class="mb-3"><i class="fas fa-check-circle me-2"></i>Tiempos de Resolución (minutos)</h6>
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label class="form-label">Prioridad Crítica</label>
                                    <InputNumber @bind-Value="slaForm.TiempoResolucionCritica" class="form-control" min="15" max="10080" />
                                    <ValidationMessage For="@(() => slaForm.TiempoResolucionCritica)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Prioridad Alta</label>
                                    <InputNumber @bind-Value="slaForm.TiempoResolucionAlta" class="form-control" min="15" max="10080" />
                                    <ValidationMessage For="@(() => slaForm.TiempoResolucionAlta)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Prioridad Media</label>
                                    <InputNumber @bind-Value="slaForm.TiempoResolucionMedia" class="form-control" min="15" max="10080" />
                                    <ValidationMessage For="@(() => slaForm.TiempoResolucionMedia)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Prioridad Baja</label>
                                    <InputNumber @bind-Value="slaForm.TiempoResolucionBaja" class="form-control" min="15" max="10080" />
                                    <ValidationMessage For="@(() => slaForm.TiempoResolucionBaja)" />
                                </div>
                            </div>

                            <hr />

                            <h6 class="mb-3"><i class="fas fa-level-up-alt me-2"></i>Configuración de Escalación</h6>
                            <div class="mb-3">
                                <div class="form-check">
                                    <InputCheckbox @bind-Value="slaForm.PermitirEscalacion" class="form-check-input" id="permitirEscalacion" />
                                    <label class="form-check-label" for="permitirEscalacion">
                                        Permitir escalación automática
                                    </label>
                                </div>
                            </div>

                            @if (slaForm.PermitirEscalacion)
                            {
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Minutos antes de llegar al SLA</label>
                                        <InputNumber @bind-Value="slaForm.MinutosAntesDeLlegar" class="form-control" min="1" max="120" />
                                        <ValidationMessage For="@(() => slaForm.MinutosAntesDeLlegar)" />
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-check mt-4">
                                            <InputCheckbox @bind-Value="slaForm.NotificarAlEscalar" class="form-check-input" id="notificarEscalar" />
                                            <label class="form-check-label" for="notificarEscalar">
                                                Notificar al escalar
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-check mt-4">
                                            <InputCheckbox @bind-Value="slaForm.NotificarAlVencer" class="form-check-input" id="notificarVencer" />
                                            <label class="form-check-label" for="notificarVencer">
                                                Notificar al vencer
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="modal-footer mt-4">
                                <button type="button" class="btn btn-secondary" @onclick="CloseModal">
                                    <i class="fas fa-times me-2"></i>Cancelar
                                </button>
                                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                    @if (isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-save me-2"></i>
                                    }
                                    @(isEditMode ? "Actualizar" : "Crear") SLA
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<SLADto>? slaList;
    private bool isLoading = true;
    private bool showModal = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private bool isError = false;
    private string messageAlert = "";
    private SLAFormModel slaForm = new();

    public class SLADto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public int TiempoRespuestaCritica { get; set; }
        public int TiempoRespuestaAlta { get; set; }
        public int TiempoRespuestaMedia { get; set; }
        public int TiempoRespuestaBaja { get; set; }
        public int TiempoResolucionCritica { get; set; }
        public int TiempoResolucionAlta { get; set; }
        public int TiempoResolucionMedia { get; set; }
        public int TiempoResolucionBaja { get; set; }
        public bool PermitirEscalacion { get; set; }
        public int MinutosAntesDeLlegar { get; set; }
        public bool NotificarAlEscalar { get; set; }
        public bool NotificarAlVencer { get; set; }
        public bool IsActive { get; set; }
        public DateTime CreatedAt { get; set; }
        public DateTime UpdatedAt { get; set; }
    }

    public class SLAFormModel
    {
        public int? Id { get; set; }
        
        [Required(ErrorMessage = "El nombre es requerido")]
        [MaxLength(100)]
        public string Nombre { get; set; } = "";

        [MaxLength(500)]
        public string? Descripcion { get; set; }

        [Range(5, 1440, ErrorMessage = "Entre 5 y 1440 minutos")]
        public int TiempoRespuestaCritica { get; set; } = 15;

        [Range(5, 1440)]
        public int TiempoRespuestaAlta { get; set; } = 30;

        [Range(5, 1440)]
        public int TiempoRespuestaMedia { get; set; } = 60;

        [Range(5, 1440)]
        public int TiempoRespuestaBaja { get; set; } = 240;

        [Range(15, 10080)]
        public int TiempoResolucionCritica { get; set; } = 60;

        [Range(15, 10080)]
        public int TiempoResolucionAlta { get; set; } = 120;

        [Range(15, 10080)]
        public int TiempoResolucionMedia { get; set; } = 480;

        [Range(15, 10080)]
        public int TiempoResolucionBaja { get; set; } = 2880;

        public bool PermitirEscalacion { get; set; } = true;

        [Range(1, 120)]
        public int MinutosAntesDeLlegar { get; set; } = 15;

        public bool NotificarAlEscalar { get; set; } = true;
        public bool NotificarAlVencer { get; set; } = true;
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public T? Data { get; set; }
        public string Message { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        await UserSession.InitializeAsync();
        
        if (!UserSession.IsLoggedIn || UserSession.CurrentUser?.TipoUsuario != TipoUsuario.Administrador)
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }

        await LoadSLAs();
    }

    private async Task LoadSLAs()
    {
        try
        {
            isLoading = true;
            var apiUrl = "http://localhost:7001/api/configuracion/slas";
            var response = await Http.GetFromJsonAsync<ApiResponse<List<SLADto>>>(apiUrl);
            
            if (response?.Success == true && response.Data != null)
            {
                slaList = response.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando SLAs: {ex.Message}");
            messageAlert = "Error al cargar los SLAs";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateModal()
    {
        isEditMode = false;
        slaForm = new SLAFormModel();
        showModal = true;
    }

    private void EditSla(SLADto sla)
    {
        isEditMode = true;
        slaForm = new SLAFormModel
        {
            Id = sla.Id,
            Nombre = sla.Nombre,
            Descripcion = sla.Descripcion,
            TiempoRespuestaCritica = sla.TiempoRespuestaCritica,
            TiempoRespuestaAlta = sla.TiempoRespuestaAlta,
            TiempoRespuestaMedia = sla.TiempoRespuestaMedia,
            TiempoRespuestaBaja = sla.TiempoRespuestaBaja,
            TiempoResolucionCritica = sla.TiempoResolucionCritica,
            TiempoResolucionAlta = sla.TiempoResolucionAlta,
            TiempoResolucionMedia = sla.TiempoResolucionMedia,
            TiempoResolucionBaja = sla.TiempoResolucionBaja,
            PermitirEscalacion = sla.PermitirEscalacion,
            MinutosAntesDeLlegar = sla.MinutosAntesDeLlegar,
            NotificarAlEscalar = sla.NotificarAlEscalar,
            NotificarAlVencer = sla.NotificarAlVencer
        };
        showModal = true;
    }

    private async Task SaveSla()
    {
        try
        {
            isSaving = true;
            var apiUrl = "http://localhost:7001/api/configuracion/slas";
            HttpResponseMessage response;
            
            if (isEditMode && slaForm.Id.HasValue)
            {
                // PUT para actualizar
                apiUrl = $"{apiUrl}/{slaForm.Id.Value}";
                response = await Http.PutAsJsonAsync(apiUrl, slaForm);
            }
            else
            {
                // POST para crear
                response = await Http.PostAsJsonAsync(apiUrl, slaForm);
            }
            
            if (response.IsSuccessStatusCode)
            {
                messageAlert = $"SLA '{slaForm.Nombre}' {(isEditMode ? "actualizado" : "creado")} exitosamente";
                isError = false;
                CloseModal();
                await LoadSLAs();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                messageAlert = $"Error al guardar el SLA: {errorContent}";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error guardando SLA: {ex.Message}");
            messageAlert = $"Error: {ex.Message}";
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteSla(int id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "¿Está seguro de eliminar este SLA? Esta acción no se puede deshacer."))
        {
            try
            {
                var apiUrl = $"http://localhost:7001/api/configuracion/slas/{id}";
                var response = await Http.DeleteAsync(apiUrl);
                
                if (response.IsSuccessStatusCode)
                {
                    messageAlert = "SLA eliminado exitosamente";
                    isError = false;
                    await LoadSLAs();
                }
                else
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    messageAlert = $"Error al eliminar el SLA: {errorContent}";
                    isError = true;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error eliminando SLA: {ex.Message}");
                messageAlert = $"Error al eliminar: {ex.Message}";
                isError = true;
            }
        }
    }

    private void CloseModal()
    {
        showModal = false;
        slaForm = new SLAFormModel();
    }

    private string FormatMinutes(int minutes)
    {
        if (minutes < 60) return $"{minutes} min";
        if (minutes < 1440) return $"{minutes / 60}h {minutes % 60}min";
        return $"{minutes / 1440}d {(minutes % 1440) / 60}h";
    }
}
