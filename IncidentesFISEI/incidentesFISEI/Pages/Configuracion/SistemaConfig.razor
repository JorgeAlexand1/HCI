@page "/configuracion/sistema"
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using incidentesFISEI.Services
@layout incidentesFISEI.Shared.Components.DashboardLayout
@inject HttpClient Http
@inject UserSessionService UserSession
@inject NavigationManager Navigation

<PageTitle>Configuración del Sistema - IncidentesFISEI</PageTitle>

<div class="sistema-config-container">
    <!-- Título con botón volver alineado -->
    <div class="page-title-section">
        <button class="btn btn-link back-button" @onclick='() => Navigation.NavigateTo("/configuracion")'>
            <i class="fas fa-arrow-left me-2"></i>Volver
        </button>
        <div class="title-content">
            <h1 class="page-main-title">
                <i class="fas fa-sliders-h me-2"></i>Configuración General del Sistema
            </h1>
            <p class="page-subtitle">Parámetros generales, escalación y retención de datos</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(messageAlert))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            <i class="fas @(isError ? "fa-exclamation-triangle" : "fa-check-circle") me-2"></i>
            @messageAlert
            <button type="button" class="btn-close" @onclick="() => messageAlert = string.Empty"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3">Cargando configuración...</p>
        </div>
    }
    else
    {
        <div class="config-form-container">
            <EditForm Model="configForm" OnValidSubmit="SaveConfiguration">
                <DataAnnotationsValidator />

                <!-- Información General -->
                <div class="config-section">
                    <h2><i class="fas fa-info-circle me-2"></i>Información General</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Nombre del Sistema <span class="text-danger">*</span></label>
                            <InputText @bind-Value="configForm.Nombre" class="form-control" placeholder="FISEI - Sistema de Gestión de Incidentes" />
                            <ValidationMessage For="@(() => configForm.Nombre)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email de Soporte</label>
                            <InputText @bind-Value="configForm.EmailSoporte" class="form-control" placeholder="soporte@fisei.edu.ec" />
                            <ValidationMessage For="@(() => configForm.EmailSoporte)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Teléfono</label>
                            <InputText @bind-Value="configForm.Telefono" class="form-control" placeholder="+593-3-123456" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Zona Horaria</label>
                            <InputSelect @bind-Value="configForm.ZonaHoraria" class="form-select">
                                <option value="America/Guayaquil">America/Guayaquil (Ecuador)</option>
                                <option value="America/Bogota">America/Bogota (Colombia)</option>
                                <option value="America/Lima">America/Lima (Perú)</option>
                                <option value="UTC">UTC</option>
                            </InputSelect>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descripción</label>
                            <InputTextArea @bind-Value="configForm.Descripcion" class="form-control" rows="2" placeholder="Descripción del sistema" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">URL del Logo</label>
                            <InputText @bind-Value="configForm.LogoUrl" class="form-control" placeholder="https://ejemplo.com/logo.png" />
                        </div>
                    </div>
                </div>

                <!-- Tiempos por Defecto -->
                <div class="config-section">
                    <h2><i class="fas fa-clock me-2"></i>Tiempos por Defecto (minutos)</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Tiempo de Respuesta</label>
                            <InputNumber @bind-Value="configForm.TiempoRespuestaDefecto" class="form-control" min="5" max="1440" />
                            <small class="text-muted">Tiempo para dar primera respuesta a un incidente</small>
                            <ValidationMessage For="@(() => configForm.TiempoRespuestaDefecto)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tiempo de Resolución</label>
                            <InputNumber @bind-Value="configForm.TiempoResolucionDefecto" class="form-control" min="5" max="10080" />
                            <small class="text-muted">Tiempo máximo para resolver un incidente</small>
                            <ValidationMessage For="@(() => configForm.TiempoResolucionDefecto)" />
                        </div>
                    </div>
                </div>

                <!-- Escalación Automática -->
                <div class="config-section">
                    <h2><i class="fas fa-level-up-alt me-2"></i>Escalación Automática</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <InputCheckbox @bind-Value="configForm.PermitirEscalacionAutomatica" class="form-check-input" id="permitirEscalacion" />
                                <label class="form-check-label" for="permitirEscalacion">
                                    Habilitar escalación automática
                                </label>
                            </div>
                            <small class="text-muted">Escalar incidentes automáticamente cuando se acerquen al vencimiento del SLA</small>
                        </div>
                        @if (configForm.PermitirEscalacionAutomatica)
                        {
                            <div class="col-md-6">
                                <label class="form-label">Porcentaje de Escalación</label>
                                <div class="input-group">
                                    <InputNumber @bind-Value="configForm.PortcentajeEscalacion" class="form-control" min="1" max="99" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <small class="text-muted">Escalar cuando se alcance este % del tiempo SLA</small>
                                <ValidationMessage For="@(() => configForm.PortcentajeEscalacion)" />
                            </div>
                        }
                    </div>
                </div>

                <!-- Notificaciones -->
                <div class="config-section">
                    <h2><i class="fas fa-bell me-2"></i>Notificaciones</h2>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <InputCheckbox @bind-Value="configForm.NotificacionesHabilitadas" class="form-check-input" id="notifHabilitadas" />
                                <label class="form-check-label" for="notifHabilitadas">
                                    Notificaciones Habilitadas
                                </label>
                            </div>
                        </div>
                        @if (configForm.NotificacionesHabilitadas)
                        {
                            <div class="col-md-4">
                                <div class="form-check form-switch">
                                    <InputCheckbox @bind-Value="configForm.NotificacionesPorEmail" class="form-check-input" id="notifEmail" />
                                    <label class="form-check-label" for="notifEmail">
                                        Notificaciones por Email
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch">
                                    <InputCheckbox @bind-Value="configForm.NotificacionesPorSistema" class="form-check-input" id="notifSistema" />
                                    <label class="form-check-label" for="notifSistema">
                                        Notificaciones en Sistema
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Auditoría -->
                <div class="config-section">
                    <h2><i class="fas fa-history me-2"></i>Auditoría y Logs</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <InputCheckbox @bind-Value="configForm.AuditoriaHabilitada" class="form-check-input" id="auditoriaHabilitada" />
                                <label class="form-check-label" for="auditoriaHabilitada">
                                    Habilitar Auditoría
                                </label>
                            </div>
                            <small class="text-muted">Registrar todas las acciones en el sistema</small>
                        </div>
                        @if (configForm.AuditoriaHabilitada)
                        {
                            <div class="col-md-6">
                                <label class="form-label">Días de Retención de Logs</label>
                                <InputNumber @bind-Value="configForm.DiasRetencionLogs" class="form-control" min="1" max="365" />
                                <small class="text-muted">Tiempo que se conservan los registros de auditoría</small>
                                <ValidationMessage For="@(() => configForm.DiasRetencionLogs)" />
                            </div>
                        }
                    </div>
                </div>

                <!-- Botones de Acción -->
                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/configuracion")'>
                        <i class="fas fa-times me-2"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="fas fa-save me-2"></i>
                        }
                        Guardar Configuración
                    </button>
                </div>
            </EditForm>
        </div>
    }
</div>

@code {
    private ConfigFormModel configForm = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isError = false;
    private string messageAlert = "";

    public class ConfigFormModel
    {
        [Required(ErrorMessage = "El nombre es requerido")]
        [MaxLength(100)]
        public string Nombre { get; set; } = "FISEI - Sistema de Gestión de Incidentes";

        [MaxLength(500)]
        public string? Descripcion { get; set; }

        [MaxLength(500)]
        public string? LogoUrl { get; set; }

        [EmailAddress]
        [MaxLength(256)]
        public string? EmailSoporte { get; set; }

        [Phone]
        [MaxLength(20)]
        public string? Telefono { get; set; }

        [Range(5, 1440)]
        public int TiempoRespuestaDefecto { get; set; } = 60;

        [Range(5, 10080)]
        public int TiempoResolucionDefecto { get; set; } = 480;

        public bool PermitirEscalacionAutomatica { get; set; } = true;

        [Range(1, 99)]
        public int PortcentajeEscalacion { get; set; } = 75;

        public bool NotificacionesHabilitadas { get; set; } = true;
        public bool NotificacionesPorEmail { get; set; } = true;
        public bool NotificacionesPorSistema { get; set; } = true;

        public bool AuditoriaHabilitada { get; set; } = true;

        [Range(1, 365)]
        public int DiasRetencionLogs { get; set; } = 90;

        [MaxLength(50)]
        public string ZonaHoraria { get; set; } = "America/Guayaquil";
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public T? Data { get; set; }
        public string Message { get; set; } = "";
    }

    public class ConfigSistemaDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public string LogoUrl { get; set; } = "";
        public string EmailSoporte { get; set; } = "";
        public string Telefono { get; set; } = "";
        public int TiempoRespuestaDefecto { get; set; }
        public int TiempoResolucionDefecto { get; set; }
        public bool PermitirEscalacionAutomatica { get; set; }
        public int PortcentajeEscalacion { get; set; }
        public bool NotificacionesHabilitadas { get; set; }
        public bool NotificacionesPorEmail { get; set; }
        public bool NotificacionesPorSistema { get; set; }
        public bool AuditoriaHabilitada { get; set; }
        public int DiasRetencionLogs { get; set; }
        public string ZonaHoraria { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        await UserSession.InitializeAsync();
        
        if (!UserSession.IsLoggedIn || UserSession.CurrentUser?.TipoUsuario != TipoUsuario.Administrador)
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }

        await LoadConfiguration();
    }

    private async Task LoadConfiguration()
    {
        try
        {
            isLoading = true;
            var apiUrl = "http://localhost:7001/api/configuracion/sistema";
            var response = await Http.GetFromJsonAsync<ApiResponse<ConfigSistemaDto>>(apiUrl);
            
            if (response?.Success == true && response.Data != null)
            {
                var data = response.Data;
                configForm = new ConfigFormModel
                {
                    Nombre = data.Nombre,
                    Descripcion = data.Descripcion,
                    LogoUrl = data.LogoUrl,
                    EmailSoporte = data.EmailSoporte,
                    Telefono = data.Telefono,
                    TiempoRespuestaDefecto = data.TiempoRespuestaDefecto,
                    TiempoResolucionDefecto = data.TiempoResolucionDefecto,
                    PermitirEscalacionAutomatica = data.PermitirEscalacionAutomatica,
                    PortcentajeEscalacion = data.PortcentajeEscalacion,
                    NotificacionesHabilitadas = data.NotificacionesHabilitadas,
                    NotificacionesPorEmail = data.NotificacionesPorEmail,
                    NotificacionesPorSistema = data.NotificacionesPorSistema,
                    AuditoriaHabilitada = data.AuditoriaHabilitada,
                    DiasRetencionLogs = data.DiasRetencionLogs,
                    ZonaHoraria = data.ZonaHoraria
                };
            }
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Error cargando configuración: {ex.Message}");
            // Si es 404, la configuración no existe aún, usar valores por defecto
            if (ex.Message.Contains("404"))
            {
                configForm = new ConfigFormModel();
            }
            else
            {
                messageAlert = "Error al cargar la configuración";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error inesperado: {ex.Message}");
            messageAlert = "Error al cargar la configuración";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveConfiguration()
    {
        try
        {
            isSaving = true;
            var apiUrl = "http://localhost:7001/api/configuracion/sistema";
            
            var response = await Http.PostAsJsonAsync(apiUrl, configForm);
            
            if (response.IsSuccessStatusCode)
            {
                messageAlert = "Configuración guardada exitosamente";
                isError = false;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error response: {errorContent}");
                messageAlert = "Error al guardar la configuración";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error guardando configuración: {ex.Message}");
            messageAlert = $"Error: {ex.Message}";
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }
}
