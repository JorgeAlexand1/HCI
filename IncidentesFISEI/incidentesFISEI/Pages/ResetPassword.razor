@page "/reset-password"
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Restablecer Contraseña - IncidentesFISEI</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="login-logo">
                <i class="fas fa-lock-open"></i>
            </div>
            <h2 class="login-title">Restablecer Contraseña</h2>
            <p class="login-subtitle">Ingresa tu nueva contraseña</p>
        </div>

        <EditForm Model="resetPasswordModel" OnValidSubmit="HandleResetPassword" class="login-form">
            <DataAnnotationsValidator />
            
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>@errorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle me-2"></i>@successMessage
                </div>
            }

            @if (!tokenValid)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-times-circle me-2"></i>
                    <strong>Token inválido o expirado</strong>
                    <p class="mb-0 mt-2">El enlace de recuperación no es válido o ha expirado. Por favor, solicita uno nuevo.</p>
                    <button type="button" class="btn btn-primary mt-3" @onclick="GoToForgotPassword">
                        <i class="fas fa-key me-2"></i>Solicitar nuevo enlace
                    </button>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label for="newPassword" class="form-label">
                        <i class="fas fa-lock me-2"></i>Nueva Contraseña
                    </label>
                    <div class="password-input-group">
                        <InputText type="@(showPassword ? "text" : "password")" id="newPassword" @bind-Value="resetPasswordModel.NewPassword" class="form-control" placeholder="Mínimo 8 caracteres" />
                        <button type="button" class="password-toggle" @onclick="TogglePasswordVisibility">
                            <i class="fas @(showPassword ? "fa-eye-slash" : "fa-eye")"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => resetPasswordModel.NewPassword)" class="validation-message" />
                </div>

                <div class="form-group">
                    <label for="confirmPassword" class="form-label">
                        <i class="fas fa-check-double me-2"></i>Confirmar Contraseña
                    </label>
                    <InputText type="password" id="confirmPassword" @bind-Value="resetPasswordModel.ConfirmPassword" class="form-control" placeholder="Repite la contraseña" />
                    <ValidationMessage For="@(() => resetPasswordModel.ConfirmPassword)" class="validation-message" />
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary btn-login" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Cambiando...</span>
                        }
                        else
                        {
                            <i class="fas fa-save me-2"></i>
                            <span>Restablecer Contraseña</span>
                        }
                    </button>
                </div>

                <div class="forgot-password-link">
                    <a href="/login" class="text-link">
                        <i class="fas fa-arrow-left me-1"></i>Volver al inicio de sesión
                    </a>
                </div>

                <div class="back-to-home-link">
                    <a href="/" class="text-link">
                        <i class="fas fa-home me-1"></i>Ir al Inicio
                    </a>
                </div>
            }
        </EditForm>
    </div>
</div>

@code {
    private ResetPasswordModel resetPasswordModel = new();
    private bool isLoading = false;
    private bool showPassword = false;
    private string errorMessage = "";
    private string successMessage = "";
    private string? resetToken;
    private bool tokenValid = false;

    public class ResetPasswordModel
    {
        [Required(ErrorMessage = "La nueva contraseña es requerida")]
        [MinLength(8, ErrorMessage = "La contraseña debe tener al menos 8 caracteres")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Debe confirmar la contraseña")]
        [Compare("NewPassword", ErrorMessage = "Las contraseñas no coinciden")]
        public string ConfirmPassword { get; set; } = "";
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public T? Data { get; set; }
        public string Message { get; set; } = "";
        public string[]? Errors { get; set; }
    }

    protected override void OnInitialized()
    {
        // Obtener token de la URL
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        resetToken = query["token"];
        
        tokenValid = !string.IsNullOrEmpty(resetToken);
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private void GoToForgotPassword()
    {
        Navigation.NavigateTo("/forgot-password");
    }

    private async Task HandleResetPassword()
    {
        try
        {
            isLoading = true;
            errorMessage = "";
            successMessage = "";
            
            if (string.IsNullOrEmpty(resetToken))
            {
                errorMessage = "Token de recuperación no válido";
                return;
            }

            var apiBaseUrl = "http://localhost:7001";
            var resetPasswordUrl = $"{apiBaseUrl}/api/auth/reset-password";
            
            var request = new 
            { 
                token = resetToken,
                newPassword = resetPasswordModel.NewPassword,
                confirmPassword = resetPasswordModel.ConfirmPassword
            };
            
            var response = await Http.PostAsJsonAsync(resetPasswordUrl, request);
            var responseContent = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                successMessage = "✅ Contraseña restablecida exitosamente. Redirigiendo al inicio de sesión...";
                StateHasChanged();
                
                // Esperar 2 segundos y redirigir al login
                await Task.Delay(2000);
                Navigation.NavigateTo("/login");
            }
            else
            {
                try
                {
                    var errorResponse = System.Text.Json.JsonSerializer.Deserialize<ApiResponse<object>>(
                        responseContent, 
                        new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                    );
                    errorMessage = errorResponse?.Message ?? "Error al restablecer la contraseña";
                }
                catch
                {
                    errorMessage = "Token inválido o expirado. Por favor, solicita un nuevo enlace de recuperación.";
                    tokenValid = false;
                }
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "No se puede conectar con el servidor. Verifique que la API esté ejecutándose.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
